*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unityweb
*.app

# Backup files
*.bak
*.backup

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

